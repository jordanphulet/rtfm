{
  "name": "rtfm",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node server/dev.ts",
    "server": "node server/main.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "fetch-dynamodb-local": "node scripts/fetch-dynamodb-local.ts",
    "shot": "node scripts/shot.ts",
    "serve-temp": "node scripts/serve-temp.ts",
    "usage": "node server/usage.ts",
    "logs": "node server/logs.ts",
    "audit": "node scripts/audit/audit.ts",
    "commit-task": "node scripts/commit-task.ts",
    "commit-worklist": "node scripts/commit-worklist.ts",
    "orchestrator-check": "node scripts/orchestrator-check.ts",
    "task-prompt": "node scripts/task-prompt.ts",
    "ops": "node scripts/ops/ops.ts",
    "aws": "set -f; command set +o braceexpand 2>/dev/null; exec node infra/run-aws.ts aws",
    "cdk": "set -f; command set +o braceexpand 2>/dev/null; exec node infra/run-aws.ts cdk"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "0.34.4",
    "@aws-sdk/client-dynamodb": "3.1151.0",
    "@aws-sdk/credential-provider-env": "3.972.74",
    "@aws-sdk/credential-provider-http": "3.972.76",
    "@aws-sdk/lib-dynamodb": "3.1151.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/space-mono": "5.3.0",
    "lucide-react": "1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@smithy/eventstream-codec": "2.2.0",
    "@types/node": "^24.19.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "aws-cdk": "2.1145.0",
    "aws-cdk-lib": "2.273.0",
    "constructs": "10.8.1",
    "happy-dom": "^20.14.5",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.64.0",
    "pngjs": "^7.0.0",
    "rolldown": "1.2.13",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
